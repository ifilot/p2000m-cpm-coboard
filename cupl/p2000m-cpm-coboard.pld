Name     P2000M_CPM_COBOARD;
PartNo   00;
Date     09/18/2026;
Revision 0.7;
Designer Ivo Filot;
Company  None;
Assembly None;
Location None;
Device   f1502ispplcc44;

PROPERTY ATMEL {POWER_RESET = OFF};
PROPERTY ATMEL {PIN_KEEP = ON};
PROPERTY ATMEL {PREASSIGN = KEEP};

/** ------------------------------------------------------------------------**/
/** ATF1502AS PLCC-44 assignment optimized for pcb/modern-revised.          **/
/** The JTAG pins (7, 13, 32 and 38) remain reserved by the ISP device.      **/
/** ------------------------------------------------------------------------**/

PIN  1 = RES_N;
PIN  2 = IORQ_N;
PIN  4 = P4_ROMS2_N;
PIN  5 = RA14;
PIN  6 = RA13;
PIN  8 = RA12;
PIN  9 = A16_RAM;
PIN 11 = A14_RAM;
PIN 12 = A12;
PIN 14 = WR_N;
PIN 16 = A13;
PIN 17 = A15_RAM;
PIN 18 = T_MODEL; /** Legacy name: physical D0, now overlay enable data. **/
PIN 19 = RAMS3_N;
PIN 20 = D7;
PIN 21 = A4;
PIN 24 = A5;
PIN 25 = A6;
PIN 26 = A7;
PIN 27 = A14;
PIN 28 = A11;
PIN 29 = RA15; /** Legacy net name: J2 pin 26 is RAMS2, not A15. **/
PIN 31 = MRQ_N;
PIN 33 = P7_RAMS2;
PIN 34 = P6_CARS2_N;
PIN 36 = P5_CARS1_N;
PIN 37 = P3_ROMS1_N;
PIN 39 = P1_RAMS1;
PIN 40 = P0_MBEN_N;
PIN 41 = P2_VIDS_N;
PIN 43 = M1_N;
PIN 44 = A15;

/** Buried control registers, updated atomically by one I/O write. **/
Pinnode = CPM_MODE;
Pinnode = BANK_EN;
Pinnode = BANK0;
Pinnode = BANK1;
Pinnode = BANK2;

/** ------------------------------------------------------------------------**/
/** CP/M mode control                                                       **/
/**                                                                          **/
/** A normal Z80 I/O write to any port in 0x20-0x2F latches D7. Reset       **/
/** returns to the stock P2000 map. M1_N excludes interrupt acknowledge     **/
/** cycles from the port strobe.                                             **/
/** ------------------------------------------------------------------------**/

CPM_WRITE = (!IORQ_N & !WR_N & M1_N & !A7 & !A6 & A5 & !A4);

CPM_MODE.d  = D7;
CPM_MODE.ck = CPM_WRITE;
CPM_MODE.ar = !RES_N;

/** OUT (20h),A places A on A15-A8 as well as the data bus. **/
/** Capture bits 3-5 via A11-A13; OUT (C),A instead sources them from B. **/
BANK_EN.d = T_MODEL;
BANK0.d = A11;
BANK1.d = A12;
BANK2.d = A13;
BANK_EN.ck = CPM_WRITE;
BANK0.ck = CPM_WRITE;
BANK1.ck = CPM_WRITE;
BANK2.ck = CPM_WRITE;
BANK_EN.ar = !RES_N;
BANK0.ar = !RES_N;
BANK1.ar = !RES_N;
BANK2.ar = !RES_N;

/** Bank 0 remains reserved for A000-DFFF. Overlay only 4000-7FFF. **/
BANK_WINDOW = CPM_MODE & BANK_EN & (BANK0 # BANK1 # BANK2)
            & !A15 & A14;
A14_RAM = BANK_WINDOW & BANK0;
A15_RAM = BANK_WINDOW & BANK1;
A16_RAM = BANK_WINDOW & BANK2;

/** ------------------------------------------------------------------------**/
/** Stock P2000 address regions                                             **/
/** ------------------------------------------------------------------------**/

NORMAL_MONITOR = (!A15 & !A14 & !A13 & !A12);                 /** 0000-0FFF **/
NORMAL_CART1   = (!A15 & !A14 & !A13 &  A12)                  /** 1000-1FFF **/
               # (!A15 & !A14 &  A13 & !A12);                 /** 2000-2FFF **/
NORMAL_CART2   = (!A15 & !A14 &  A13 &  A12)                  /** 3000-3FFF **/
               # (!A15 &  A14 & !A13 & !A12);                 /** 4000-4FFF **/
NORMAL_VIDEO   = (!A15 &  A14 & !A13 & A12 & !A11);           /** 5000-57FF **/
NORMAL_RAM1    = (!A15 &  A14 &  A13)                         /** 6000-7FFF **/
               # ( A15 & !A14 & !A13);                        /** 8000-9FFF **/
NORMAL_RAM2    = ( A15 & (A14 # A13));                        /** A000-FFFF **/

/** ------------------------------------------------------------------------**/
/** Revised CP/M address regions                                            **/
/** ------------------------------------------------------------------------**/

CPM_RAM1  = (!A15 & !A14);                                    /** 0000-3FFF **/
CPM_RAM2  = (!A15 &  A14)                                     /** 4000-7FFF **/
          # ( A15 & !A14 & !A13);                             /** 8000-9FFF **/
CPM_RAM3  = ( A15 & !A14 &  A13)                              /** A000-BFFF **/
          # ( A15 &  A14 & !A13);                             /** C000-DFFF **/
CPM_CART1 = ( A15 &  A14 &  A13 & !A12);                      /** E000-EFFF **/
CPM_VIDEO = ( A15 &  A14 &  A13 &  A12);                      /** F000-FFFF **/

/** M video uses translated page 5 with RAMS2 low (verified on hardware). **/
/** P2000M is fixed in this image; pin 18 receives overlay enable data. **/

/** Select the active map. Stock PROM outputs are address-only. **/
SEL_MONITOR = !CPM_MODE & NORMAL_MONITOR;
SEL_CART1   = (!CPM_MODE & NORMAL_CART1) # (CPM_MODE & CPM_CART1);
SEL_CART2   = !CPM_MODE & NORMAL_CART2;
SEL_VIDEO   = !CPM_MODE & NORMAL_VIDEO;
SEL_RAM1    = (!CPM_MODE & NORMAL_RAM1) # (CPM_MODE & CPM_RAM1);
SEL_RAM2    = (!CPM_MODE & NORMAL_RAM2)
            # (CPM_MODE & CPM_RAM2 & !BANK_WINDOW);
SEL_RAM3    = (CPM_MODE & CPM_RAM3) # BANK_WINDOW;

MEM_CYCLE = !MRQ_N;
/** Gate motherboard selects only in CP/M mode, preserving stock timing. **/
PROM_ENABLE = !CPM_MODE # MEM_CYCLE;

/** ------------------------------------------------------------------------**/
/** Motherboard PROM outputs and local SRAM select                          **/
/** ------------------------------------------------------------------------**/

P0_MBEN_N  = !(PROM_ENABLE & (SEL_MONITOR # SEL_CART1 # SEL_CART2 # SEL_RAM1));
P1_RAMS1   =  (PROM_ENABLE & SEL_RAM1);
P2_VIDS_N  = !(PROM_ENABLE & SEL_VIDEO);
P3_ROMS1_N = !(PROM_ENABLE & SEL_MONITOR);
P4_ROMS2_N = 'b'1;
P5_CARS1_N = !(PROM_ENABLE & SEL_CART1);
P6_CARS2_N = !(PROM_ENABLE & SEL_CART2);
P7_RAMS2   =  (PROM_ENABLE & SEL_RAM2);
RAMS3_N    = !(MEM_CYCLE & SEL_RAM3);

/** ------------------------------------------------------------------------**/
/** Expansion-board address translation                                    **/
/**                                                                          **/
/** REQUIRES J1 pin 26 isolated from A15; real A15 enters via U3 pin 14. **/
/** Only A12-A14 reach the expansion board; translate these by +6 mod 8. **/
/** Expansion pin 26 is RAMS2, NOT A15. Its legacy net name is RA15. **/
/** ------------------------------------------------------------------------**/

/** With RAMS2 low, translated page 5 also selects the M video board. **/
/** Banking suppresses RAMS2, so 7000-7FFF must not translate to page 5. **/
/** Clear expansion A12 during the overlay: page 5 becomes harmless 4. **/
/** CPU/SRAM address lines and the genuine F000-FFFF video map are unchanged. **/
CPM_RA12 = A12 & !(BANK_WINDOW & A13);
CPM_RA13 = !A13;
CPM_RA14 = (A14 & A13) # (!A14 & !A13);

RA12 = (!CPM_MODE & A12) # (CPM_MODE & CPM_RA12);
RA13 = (!CPM_MODE & A13) # (CPM_MODE & CPM_RA13);
RA14 = (!CPM_MODE & A14) # (CPM_MODE & CPM_RA14);
RA15 = P7_RAMS2;
