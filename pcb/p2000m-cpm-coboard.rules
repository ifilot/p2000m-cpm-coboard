
(rules PCB p2000m-cpm-coboard.dsn
  (snap_angle 
    fortyfive_degree
  )
  (rule
    (width 200.0)
    (clearance 200.0)
    (clearance 100.0 (type smd_to_turn_gap))
    (clearance 50.0 (type smd))
    (clearance 500.0 (type "board_edge"))
  )
  (padstack "Via[0-1]_600:300_um"
    (shape
      (circle F.Cu 600.0 0.0 0.0)
    )
    (shape
      (circle B.Cu 600.0 0.0 0.0)
    )
    (attach off)
  )
  (via 
    "Via[0-1]_600:300_um" "Via[0-1]_600:300_um" default
  )
  (via_rule
    default "Via[0-1]_600:300_um"
  )
  (via_rule
    default "Via[0-1]_600:300_um"
  )
  (class default
    GND VCC P0 P1 P2 P3 P4 P5
    P6 P7 A11 A12 A13 A14 A15 "/~{T_SEL}"
    "Net-(J3-Pin_2)" A7 A6 A4 ~{IORQ} ~{WR} A5 "unconnected-(U5-O7-Pad7)"
    "unconnected-(U5-O6-Pad9)" "unconnected-(U5-O5-Pad10)" "unconnected-(U5-O4-Pad11)" "unconnected-(U5-O3-Pad12)" "unconnected-(U5-O2-Pad13)" "unconnected-(U5-O1-Pad14)" "/OUT_$2x" ~{RAMS3}
    ~{RES} D7 "/~{CPM_SEL}" "unconnected-(U4B-~{Q}-Pad8)" "unconnected-(U4B-Q-Pad9)" "unconnected-(U4B-D-Pad12)" A3 A2
    A1 A0 D0 D1 D2 D3 D4 D5
    D6 A10 ~{RD} A9 A8 D RA12 RA13
    RA14 RA15 ~{MRQ} ~{INT} ~{WAIT} ~{M1} ~{LOCK} ~{RFSH}
    KBI20 ~{PHI} ~{PHI2} "4MHz" "unconnected-(U6-C4-Pad9)" "unconnected-(U2-NC-Pad1)" "unconnected-(U2-D4-Pad18)" "unconnected-(U2-NC-Pad30)"
    "unconnected-(U3-Pad15)" "unconnected-(U3-Pad16)"
    (clearance_class default)
    (via_rule default)
    (rule
      (width 200.0)
    )
    (circuit 
      (use_layer F.Cu B.Cu)
    )
  )
)